# Render Server Environment Variables
PORT=10000
NODE_ENV=production

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=apipilot

# CORS Allowed Origins (Comma separated URLs or Vercel URL)
CORS_ORIGIN=https://apipilot.vercel.app,http://localhost:5173

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_production_access_secret_key_here
JWT_REFRESH_SECRET=your_production_refresh_secret_key_here

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
